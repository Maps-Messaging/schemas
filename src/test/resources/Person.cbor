{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "PersonCbor",
  "type": "object",
  "properties": {
    "stringId": {
      "type": "string",
      "description": "ASCII string up to 64 characters"
    },
    "intId": {
      "type": "integer",
      "description": "32-bit integer value"
    },
    "longId": {
      "type": "integer",
      "description": "64-bit integer value"
    },
    "floatId": {
      "type": "number",
      "description": "Float precision value"
    },
    "doubleId": {
      "type": "number",
      "description": "Double precision value"
    },
    "booleanId": {
      "type": "boolean",
      "description": "Boolean value true/false"
    },
    "bytesId": {
      "type": "string",
      "contentEncoding": "base64",
      "description": "Base64-encoded byte array"
    },
    "arrayId": {
      "type": "array",
      "description": "Array of integers",
      "items": { "type": "integer" },
      "minItems": 5,
      "maxItems": 5
    },
    "enumId": {
      "type": "string",
      "enum": ["RED", "GREEN", "BLUE"],
      "description": "Enumerated color value"
    },
    "timestampId": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 timestamp (UTC preferred)"
    }
  },
  "required": [
    "stringId",
    "intId",
    "longId",
    "floatId",
    "doubleId",
    "booleanId",
    "bytesId",
    "arrayId",
    "enumId",
    "timestampId"
  ]
}
